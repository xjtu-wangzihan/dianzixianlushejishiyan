 264          // 基本日期合法性检查（简化：未处理闰年2月天数精确）
 265          int validate_date(int y,int m,int d,int hh,int mm,int ss)
 266          {
 267   1          if(y < 1970 || y > 9999) return 0;
 268   1          if(m < 1 || m > 12) return 0;
 269   1          if(d < 1) return 0;
 270   1          if(hh < 0 || hh > 23) return 0;
 271   1          if(mm < 0 || mm > 59) return 0;
 272   1          if(ss < 0 || ss > 59) return 0;
 273   1          // 简化每月天数判断
 274   1          if(m==1||m==3||m==5||m==7||m==8||m==10||m==12)
 275   1          {
 276   2              if(d>31) return 0;
 277   2          }
 278   1          else if(m==4||m==6||m==9||m==11)
 279   1          {
 280   2              if(d>30) return 0;
 281   2          }
 282   1          else     // 2月
 283   1          {
 284   2              // 闰年判断
 285   2              int leap = ( (y%4==0 && y%100!=0) || (y%400==0) );
 286   2              if(leap)
 287   2              {
 288   3                  if(d>29) return 0;
 289   3              }
 290   2              else
 291   2              {
 292   3                  if(d>28) return 0;
 293   3              }
 294   2          }
 295   1          return 1;
 296   1      }
