 379          int calculate_expression(uchar *exp)
 380          {
 381   1          int num1 = 0, num2 = 0;
 382   1          char op = 0;
 383   1          int i = 0;
 384   1      
 385   1          // 解析第一个数
 386   1          while (exp[i] >= '0' && exp[i] <= '9')
 387   1          {
 388   2              num1 = num1 * 10 + (exp[i] - '0');
 389   2              i++;
 390   2          }
 391   1      
 392   1          op = exp[i++]; // 运算符 + - * /
 393   1      
 394   1          // 解析第二个数
 395   1          while (exp[i] >= '0' && exp[i] <= '9')
 396   1          {
 397   2              num2 = num2 * 10 + (exp[i] - '0');
 398   2              i++;
 399   2          }
 400   1      
 401   1          // 执行运算
 402   1          switch(op)
 403   1          {
 404   2              case '+':
 405   2                  return num1 + num2;
 406   2              case '-':
 407   2                  return num1 - num2;
 408   2              case '*':
 409   2                  return num1 * num2;
 410   2              case '/':
 411   2                  if (num2 == 0) return 0;  // 除零保护
 412   2                  return num1 / num2;
 413   2              default:
 414   2                  return 0;
 415   2          }
 416   1      }
