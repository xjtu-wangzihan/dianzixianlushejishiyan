 167          uchar kbscan(void)
 168          {
 169   1          unsigned char sccode,recode;
 170   1          P1=0x0f;
 171   1          if ((P1 & 0x0f) != 0x0f)
 172   1          {
 173   2              delay(20);
 174   2              if ((P1&0x0f)!= 0x0f)
 175   2              {
 176   3                  sccode = 0xef;
 177   3                  while((sccode&0x01)!=0)
 178   3                  {
 179   4                      P1=sccode;
