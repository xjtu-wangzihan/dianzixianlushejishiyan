 180   4                      if((P1&0x0f)!=0x0f)
 181   4                      {
 182   5                          recode=(P1&0x0f)|0xf0;
 183   5                          while((P1&0x0f)!=0x0f);
 184   5                          return((~sccode)+(~recode));
 185   5                      }
 186   4                      else
 187   4                          sccode=(sccode<<1)|0x01;
 188   4                  }
 189   3              }
 190   2          }
 191   1          return 0;
 192   1      }
