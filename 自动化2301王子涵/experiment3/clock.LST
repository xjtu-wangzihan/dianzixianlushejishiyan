 162          uchar kbscan(void)
 163          {
 164   1          unsigned char sccode,recode;
 165   1          P1=0x0f;
 166   1          if ((P1 & 0x0f) != 0x0f)
 167   1          {
 168   2              delay(20);
 169   2              if ((P1&0x0f)!= 0x0f)
 170   2              {
 171   3                  sccode = 0xef;
 172   3                  while((sccode&0x01)!=0)
 173   3                  {
 174   4                      P1=sccode;
 175   4                      if((P1&0x0f)!=0x0f)
 176   4                      {
 177   5                          recode=(P1&0x0f)|0xf0;
 178   5                          while((P1&0x0f)!=0x0f);
 179   5                          return((~sccode)+(~recode));
