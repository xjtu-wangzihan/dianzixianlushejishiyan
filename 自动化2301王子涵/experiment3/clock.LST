 259          // 基本日期合法性检查（简化：未处理闰年2月天数精确）
 260          int validate_date(int y,int m,int d,int hh,int mm,int ss)
 261          {
 262   1          if(y < 1970 || y > 9999) return 0;
 263   1          if(m < 1 || m > 12) return 0;
 264   1          if(d < 1) return 0;
 265   1          if(hh < 0 || hh > 23) return 0;
 266   1          if(mm < 0 || mm > 59) return 0;
 267   1          if(ss < 0 || ss > 59) return 0;
 268   1          // 简化每月天数判断
 269   1          if(m==1||m==3||m==5||m==7||m==8||m==10||m==12)
 270   1          {
 271   2              if(d>31) return 0;
 272   2          }
 273   1          else if(m==4||m==6||m==9||m==11)
 274   1          {
 275   2              if(d>30) return 0;
 276   2          }
 277   1          else     // 2月
 278   1          {
 279   2              // 闰年判断
 280   2              int leap = ( (y%4==0 && y%100!=0) || (y%400==0) );
 281   2              if(leap)
 282   2              {
 283   3                  if(d>29) return 0;
 284   3              }
 285   2              else
 286   2              {
 287   3                  if(d>28) return 0;
 288   3              }
 289   2          }
 290   1          return 1;
 291   1      }
