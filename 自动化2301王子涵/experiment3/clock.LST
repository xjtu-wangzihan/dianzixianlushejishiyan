 417   1          TH0 = (TIMER0_RELOAD >> 8) & 0xFF;
 418   1          TL0 = (TIMER0_RELOAD & 0xFF);
 419   1      
 420   1          ET0 = 1;   // 允许定时器0中断
 421   1          EA = 1;    // 允许总中断
 422   1          TR0 = 1;   // 启动定时器0
 423   1      }
