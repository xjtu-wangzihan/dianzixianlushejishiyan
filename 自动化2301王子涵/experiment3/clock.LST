 371          int calculate_expression(uchar *exp)
 372          {
 373   1          int num1 = 0, num2 = 0;
 374   1          char op = 0;
 375   1          int i = 0;
 376   1      
 377   1          // 解析第一个数
 378   1          while (exp[i] >= '0' && exp[i] <= '9')
 379   1          {
 380   2              num1 = num1 * 10 + (exp[i] - '0');
 381   2              i++;
 382   2          }
 383   1      
 384   1          op = exp[i++]; // 运算符 + - * /
 385   1      
 386   1          // 解析第二个数
 387   1          while (exp[i] >= '0' && exp[i] <= '9')
 388   1          {
 389   2              num2 = num2 * 10 + (exp[i] - '0');
 390   2              i++;
 391   2          }
 392   1      
 393   1          // 执行运算
 394   1          switch(op)
 395   1          {
 396   2              case '+':
 397   2                  return num1 + num2;
 398   2              case '-':
 399   2                  return num1 - num2;
 400   2              case '*':
 401   2                  return num1 * num2;
 402   2              case '/':
 403   2                  if (num2 == 0) return 0;  // 除零保护
 404   2                  return num1 / num2;
 405   2              default:
 406   2                  return 0;
 407   2          }
 408   1      }
