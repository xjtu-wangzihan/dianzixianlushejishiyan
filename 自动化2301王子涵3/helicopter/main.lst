 261          void draw_buffer(uchar *buffer,Queue *Q)
 262          {
 263   1        uchar num=Q->number;
 264   1        uchar index=Q->front;
 265   1        uchar count=0;
 266   1        while(num--!=0)
 267   1        { 
 268   2          buffer[(63-Q->base[index])*16+(count>>3)]|=0x80>>(count&0x07);
 269   2          index=(index+1)%129;//实现index逐次往队尾移一位
 270   2          ++count;
 271   2        }
 272   1      }
