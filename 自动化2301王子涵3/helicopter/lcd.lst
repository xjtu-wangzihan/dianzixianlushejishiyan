 193          
 194          //绘制函数
 195          void drawPoint2(uchar x_index,uchar y,unsigned char tempH,unsigned char tempL, uchar color)
 196          {
 197   1          uchar row, collum;
 198   1          WriteCommand(0x34);
 199   1          WriteCommand(0x36);
 200   1          collum = x_index;
 201   1          if (y < 32)
 202   1          {
 203   2              row = y-4;
 204   2          }
 205   1          else
 206   1          {
 207   2              row = y - 32;
 208   2              collum += 8;
 209   2          }
 210   1          //设置行地址
 211   1          WriteCommand(0x80 + row);
 212   1          
 213   1          //设置列地址
 214   1          WriteCommand(0x80 + collum);
 215   1          if (color)
 216   1          {
 217   2              WriteData(tempH);//写入高字节数据
 218   2              WriteData(tempL);//低字节数据
 219   2          }
 220   1          else
 221   1          {
 222   2              WriteData(~tempH);
 223   2              WriteData(~tempL);
 224   2          }
 225   1      }
 226          
 227          //屏幕显示函数
 228          void ScreenShow(uchar *imagePtr,uchar *reference)
 229          {
 230   1        uchar i, j;
 231   1        
 232   1        for(i = 0; i < 64; ++i)
 233   1        {
 234   2          for(j=0;j<8;++j)
 235   2          {
 236   3            if((*imagePtr != *reference) || (*(imagePtr+1)  != *(reference+1)))
 237   3            {//绘制点
 238   4              drawPoint2(j,i,*imagePtr,*(imagePtr+1),1);
 239   4            }
 240   3            imagePtr+=2;
C51 COMPILER V9.52.0.0   LCD                                                               12/03/2025 00:38:02 PAGE 5   

 241   3            reference+=2;
 242   3          }
 243   2        }
 244   1      }
