 107          void LineClear(uchar line)
 108          {
 109   1      
 110   1          uchar i;
 111   1          WriteCommand(0x30);      //8BitMCU
 112   1          WriteCommand(AC_TABLE[8*line]);      //起始位置
 113   1      
 114   1          for(i=0; i<16; i++)
 115   1          {
 116   2              WriteData(0x20);//空格
