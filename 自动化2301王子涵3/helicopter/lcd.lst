 164          //image init and show
 165          void ImageShow(uchar *imagePtr)
 166          { uchar i, j, k, columnPosition;
 167   1        for(i = 0; i < 2; i++)
 168   1        {
 169   2          columnPosition = 0x80 + 0x08 * i;
 170   2          for(j = 0; j < 32; j++)
 171   2          {
 172   3            
 173   3            for(k = 0; k < 8; k++)    //全屏显示
 174   3            {
 175   4              //RE = 1
 176   4              WriteCommand(0x34);
 177   4              //set start position
 178   4              WriteCommand(0x80 + j);
C51 COMPILER V9.52.0.0   LCD                                                               12/03/2025 00:38:02 PAGE 4   

 179   4              WriteCommand(columnPosition + k);
 180   4              
 181   4              //RE = 1
 182   4              WriteCommand(0x30);
 183   4              //write two bytes continuously
 184   4              WriteData(*imagePtr++);
 185   4              WriteData(*imagePtr++);
 186   4            }
 187   3          }
 188   2        }
 189   1        WriteCommand(0x32);
 190   1        WriteCommand(0x36);
 191   1      }
