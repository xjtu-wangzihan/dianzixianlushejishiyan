 162          // 基本日期合法性检查（简化：未处理闰年2月天数精确）
 163          int validate_date(int y,int m,int d,int hh,int mm,int ss)
 164          {
 165   1        if(y < 1970 || y > 9999) return 0;
 166   1        if(m < 1 || m > 12) return 0;
 167   1        if(d < 1) return 0;
 168   1        if(hh < 0 || hh > 23) return 0;
 169   1        if(mm < 0 || mm > 59) return 0;
 170   1        if(ss < 0 || ss > 59) return 0;
 171   1        // 简化每月天数判断
 172   1        if(m==1||m==3||m==5||m==7||m==8||m==10||m==12)
 173   1        {
 174   2          if(d>31) return 0;
 175   2        }
 176   1        else if(m==4||m==6||m==9||m==11)
 177   1        {
 178   2          if(d>30) return 0;
C51 COMPILER V9.52.0.0   MAIN                                                              11/25/2025 22:07:19 PAGE 4   

 179   2        }
 180   1        else     // 2月
 181   1        {
 182   2          // 闰年判断
 183   2          int leap = ( (y%4==0 && y%100!=0) || (y%400==0) );
 184   2          if(leap)
 185   2          {
 186   3            if(d>29) return 0;
 187   3          }
 188   2          else
 189   2          {
 190   3            if(d>28) return 0;
 191   3          }
 192   2        }
 193   1        return 1;
 194   1      }
