 274          int calculate_expression(uchar *exp)
 275          {
 276   1        int num1 = 0, num2 = 0;
 277   1        char op = 0;
 278   1        int i = 0;
 279   1      
 280   1        // 解析第一个数
 281   1        while (exp[i] >= '0' && exp[i] <= '9')
 282   1        {
 283   2          num1 = num1 * 10 + (exp[i] - '0');
 284   2          i++;
 285   2        }
 286   1      
 287   1        op = exp[i++]; // 运算符 + - * /
 288   1      
 289   1        // 解析第二个数
 290   1        while (exp[i] >= '0' && exp[i] <= '9')
 291   1        {
 292   2          num2 = num2 * 10 + (exp[i] - '0');
 293   2          i++;
 294   2        }
 295   1      
 296   1        // 执行运算
 297   1        switch(op)
 298   1        {
 299   2          case '+':
 300   2            return num1 + num2;
 301   2          case '-':
 302   2            return num1 - num2;
C51 COMPILER V9.52.0.0   MAIN                                                              11/25/2025 22:07:19 PAGE 6   

 303   2          case '*':
 304   2            return num1 * num2;
 305   2          case '/':
 306   2            if (num2 == 0) return 0;  // 除零保护
 307   2            return num1 / num2;
 308   2          default:
 309   2            return 0;
 310   2        }
 311   1      }
