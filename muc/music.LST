 275          #define SONG_COUNT 3 // 定义歌曲的总数
 276          // 创建一个指针数组，用于存放所有歌曲的地址
 277          unsigned char code *song_list[SONG_COUNT] = { song1_tab, song2_tab, song3_tab };
 278          
 279          // 毫秒级延时函数
 280          void DelayMs(unsigned int c)
 281          {
 282   1          unsigned char a, b;
 283   1          for (;c>0;c--)
 284   1              for (b=19;b>0;b--)
 285   1                  for (a=130;a>0;a--);
 286   1      }
 287          
 288          // 定时器0中断服务程序，用于控制节拍
 289          void int0() interrupt 1
 290          {
 291   1          TH0 = 0xd8; // 重新装载10ms定时初值
 292   1          TL0 = 0xef;
 293   1          g_beat--;
 294   1      }
 295          
 296          // 控制音调(频率)的延时
 297          void AudioFrequencyDelay (unsigned char m)
 298          {
 299   1          unsigned i=3*m;
 300   1          while(--i);
 301   1      }
 302          
 303          // [修改点 1] 在最耗时的函数中加入按键检测
C51 COMPILER V9.52.0.0   MUSIC                                                             09/29/2025 12:12:18 PAGE 6   

 304          // 播放一个音符，如果在播放期间检测到按键，则立刻停止并返回
 305          void BeepTone(unsigned char tone, unsigned char beat)
 306          {
 307   1          g_beat = beat;
 308   1          TR0 = 1; // 开启定时器0，开始计算节拍
 309   1          while(g_beat != 0 && !g_key_pressed_flag) // 在节拍未结束且未检测到按键时循环
 310   1          {
 311   2              GPIO_Beep = ~GPIO_Beep;
 312   2              AudioFrequencyDelay(tone);
 313   2      
 314   2              // 在产生音频的循环中检测按键，确保最高响应性
 315   2              if (GPIO_Key == 0)
 316   2              {
 317   3                  DelayMs(20); // 按键消抖
 318   3                  if (GPIO_Key == 0) // 确认按键按下
 319   3                  {
 320   4                      g_key_pressed_flag = 1; // 设置按键标志
 321   4                      while(!GPIO_Key); // 等待按键释放
 322   4                  }
 323   3              }
 324   2          }
 325   1          TR0 = 0; // 关闭定时器0
 326   1      }
 327          
 328          // [修改点 2] 播放歌曲函数也要能被中断
 329          void PlaySong(unsigned char code *music_tab)
 330          {
 331   1          unsigned int i = 0;
 332   1          unsigned char tmpTone = 0;
 333   1      
 334   1          g_key_pressed_flag = 0; // 开始播放前，清除按键标志
 335   1      
 336   1          while(!g_key_pressed_flag) // 循环条件：按键未被按下
 337   1          {
 338   2              // 每次循环开始时都检查按键，确保在音符之间也能快速响应
 339   2              if (GPIO_Key == 0)
 340   2              {
 341   3                  DelayMs(20);
 342   3                  if (GPIO_Key == 0)
 343   3                  {
 344   4                      g_key_pressed_flag = 1;
 345   4                      while(!GPIO_Key);
 346   4                      continue; // 跳出本次循环，外层while会判断标志并退出
 347   4                  }
 348   3              }
 349   2      
 350   2              tmpTone = music_tab[i];
 351   2              if(tmpTone == 0x00) // 如果碰到结束符
 352   2              {
 353   3                  return; // 正常结束播放
 354   3              }
 355   2              else if(tmpTone == 0xff) // 若碰到休止符
 356   2              {
 357   3                  i++;
 358   3                  TR0 = 0;
 359   3                  DelayMs(100); // 休止符延时
 360   3                  continue;
 361   3              }
 362   2              else
 363   2              {
 364   3                  unsigned char tone, beat;
 365   3                  tone = music_tab[i++];
C51 COMPILER V9.52.0.0   MUSIC                                                             09/29/2025 12:12:18 PAGE 7   

 366   3                  beat = music_tab[i++];
 367   3                  BeepTone(tone, beat); // 调用修改后的BeepTone
 368   3              }
 369   2          }
 370   1      }
 371          
 372          
 373          // 初始化定时器0
 374          void InitTimer0()
 375          {
 376   1          TMOD = 0x01; // 选择16位计数器
 377   1          TH0 = 0xd8;  // (65535 - 10000) / 256
 378   1          TL0 = 0xef;  // (65535 - 10000) % 256
 379   1          IE = 0x82;   // 允许定时器T0中断和总中断
 380   1      }
 381          
 382          // [修改点 3] 主函数逻辑简化
 383          void main()
 384          {
 385   1          InitTimer0();
 386   1      
 387   1          while(1)
 388   1          {
 389   2              // 播放当前索引指向的歌曲
 390   2              // PlaySong函数现在会在检测到按键时自行退出
 391   2              PlaySong(song_list[g_song_index]);
 392   2      
 393   2              // 从PlaySong退出后，无论是正常结束还是被中断，都检查按键标志
 394   2              if (g_key_pressed_flag)
 395   2              {
 396   3                  // 如果是因按键而中断，则切换到下一首歌
 397   3                  g_song_index++;
 398   3                  if (g_song_index >= SONG_COUNT)
 399   3                  {
 400   4                      g_song_index = 0; // 循环播放
 401   4                  }
 402   3              }
 403   2              // 如果是正常播放结束，代码会继续执行到这里。
 404   2              // 由于没有按键按下，g_song_index 不会改变，
 405   2              // 下一次循环会重新播放同一首歌。
 406   2              // 如果你希望正常结束后自动播放下一首，
 407   2              // 可以将上面的 if 判断逻辑改为无条件执行 g_song_index++。
 408   2          }
 409   1      }


