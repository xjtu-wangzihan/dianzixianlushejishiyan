  64          #include <reg52.h>
  65          #define uchar unsigned char
  66          
  67          // 外部中断切换模式变量
  68          volatile uchar g_songSelect = 0;
  69          
  70          // 延时函数
  71          void delay()
  72          {
  73   1          uchar a,b;
  74   1          for(a=200;a;a--)
  75   1              for(b=200;b;b--);
  76   1      }
  77          
  78          // 外部中断0服务函数（模式切换）
  79          void ExtInt0_ISR() interrupt 0
  80          {
  81   1          delay();               // 简单防抖
  82   1          g_songSelect++;        // 模式切换
  83   1          if(g_songSelect > 2)   // 超过最大模式返回0
  84   1              g_songSelect = 0;
  85   1      }
  86          
  87          // 外部中断初始化
  88          void InitExtInt0()
  89          {
  90   1          IT0 = 1;   // 下降沿触发
  91   1          EX0 = 1;   // 允许外部中断0
  92   1          EA  = 1;   // 总中断允许
  93   1          IP  = 0x01; // 设置 INT0 高优先级
  94   1      }
  95          
  96          void main()
  97          {
  98   1          uchar tmp = 1;
  99   1          uchar dir = 0;  // 流水灯方向：0=左移，1=右移
 100   1          uchar toggle = 0; // 全亮全灭切换标志
 101   1      
 102   1          InitExtInt0();  // 初始化外部中断
 103   1      
 104   1          while(1)
 105   1          {
 106   2              if(g_songSelect == 0)  // 模式0：单向流水灯
 107   2              {
 108   3                  P0 = ~tmp;
 109   3                  delay();
 110   3                  tmp <<= 1;
 111   3                  if(tmp == 0) tmp = 1;
 112   3              }
 113   2              else if(g_songSelect == 1)  // 模式1：双向流水灯
 114   2              {
 115   3                  P0 = ~tmp;
 116   3                  delay();
 117   3                  if(dir == 0)  // 左移
C51 COMPILER V9.52.0.0   PAO                                                               09/29/2025 11:49:14 PAGE 3   

 118   3                  {
 119   4                      tmp <<= 1;
 120   4                      if(tmp == 0x80) dir = 1;  // 到达左边界，反向
 121   4                  }
 122   3                  else          // 右移
 123   3                  {
 124   4                      tmp >>= 1;
 125   4                      if(tmp == 0x01) dir = 0;  // 到达右边界，反向
 126   4                  }
 127   3              }
 128   2              else if(g_songSelect == 2)  // 模式2：全亮全灭
 129   2              {
 130   3                  if(toggle == 0)
 131   3                  {
 132   4                      P0 = 0x00;   // 全亮（低电平点亮）
 133   4                  }
 134   3                  else
 135   3                  {
 136   4                      P0 = 0xFF;   // 全灭
 137   4                  }
 138   3                  toggle ^= 1;      // 切换状态
 139   3                  delay();
 140   3              }
 141   2          }
 142   1      }


